{
  "name": "mythos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:panorama-assets",
    "dev": "vite",
    "prebuild": "npm run generate:panorama-assets",
    "build": "tsc -b && vite build",
    "generate:map": "node scripts/generate-ancient-map.mjs",
    "generate:panorama-previews": "node scripts/generate-panorama-previews.mjs",
    "generate:panorama-mobile": "node scripts/generate-panorama-mobile.mjs",
    "generate:panorama-assets": "npm run generate:panorama-previews && npm run generate:panorama-mobile",
    "review:panoramas": "node scripts/generate-panorama-review.mjs",
    "preview": "vite preview",
    "check:assets": "node scripts/check-panorama-assets.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.185.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@turf/bbox-clip": "^7.3.5",
    "@types/leaflet": "^1.9.21",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "sharp": "^0.35.3",
    "topojson-client": "^3.1.0",
    "vitest": "latest",
    "world-atlas": "^2.0.2"
  }
}
